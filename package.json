{
  "name": "mateventura",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:portable": "npm run build && python3 scripts/build_portable_html.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "validate:fun": "node scripts/validate_fun_challenges.mjs",
    "verify": "npm run typecheck && npm run validate:fun && npm run test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.1.3",
    "typescript": "6.0.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "vitest": "4.1.7"
  }
}
